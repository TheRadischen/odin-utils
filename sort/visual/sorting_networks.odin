
package sorting

/*
optimal sorting networks by
https://bertdobbelaere.github.io/sorting_networks.html#N16L60D10
*/

/*
cond_swap :: #force_inline proc(arr: []int, l, r: int) -> int #no_bounds_check {
	x := cast(int)(arr[l] < arr[r]) * (r - l)
	arr[l], arr[r] = arr[r - x], arr[l + x]
	return x
}
*/
cond_swap_net :: proc(arr: []int, l, r: int) {
	cond_swap(&arr[r], &arr[l])
}
sort_network_2 :: proc(arr: []int) {
	cond_swap_net(arr, 0, 1)
}
sort_network_3 :: proc(arr: []int) {
	cond_swap_net(arr, 0, 2)
	cond_swap_net(arr, 0, 1)
	cond_swap_net(arr, 1, 2)
}
sort_network_4 :: proc(arr: []int) {
	cond_swap_net(arr, 0, 2)
	cond_swap_net(arr, 1, 3)
	cond_swap_net(arr, 0, 1)
	cond_swap_net(arr, 2, 3)
	cond_swap_net(arr, 1, 2)
}
